# Production Environment Template
DOMAIN=dars.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# PostgreSQL
POSTGRES_DB=dars
POSTGRES_USER=dars_admin
POSTGRES_PASSWORD=replace_with_a_secure_random_password_min_32_chars

# Authentication Secrets
JWT_ACCESS_SECRET=replace_with_a_secure_random_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_jwt_refresh_secret_min_32_chars

# SMTP Mail Delivery
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@dars.yourdomain.com
SMTP_PASS=replace_with_smtp_password
SMTP_FROM="Dars LMS <noreply@dars.yourdomain.com>"
