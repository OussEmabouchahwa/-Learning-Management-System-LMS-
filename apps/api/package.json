    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.18.0",
    "argon2": "^0.40.3",
    "cookie-parser": "^1.4.6",
    "file-type": "^16.5.4",
    "helmet": "^7.1.0",
    "nestjs-pino": "^4.1.0",
    "nestjs-zod": "^3.0.0",
